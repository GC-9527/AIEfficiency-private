{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiefficiency.local/schemas/operation-map.schema.json",
  "title": "AIEfficiency Operation Map",
  "type": "object",
  "required": [
    "version",
    "projectId",
    "operations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object"
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "objective",
          "successCriteria",
          "strategies"
        ],
        "properties": {
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "coreInteractionUnderTest": {
            "type": [
              "string",
              "null"
            ]
          },
          "successCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "strategies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "channel",
                "priority",
                "enabled"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "channel": {
                  "type": "string"
                },
                "priority": {
                  "type": "integer",
                  "minimum": 0
                },
                "enabled": {
                  "type": "boolean"
                },
                "platforms": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "preconditions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "command": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "selector": {
                  "type": "object"
                },
                "verify": {
                  "type": "object"
                },
                "fallbackTo": {
                  "type": "string"
                },
                "lastVerifiedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "humanHandoff": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
