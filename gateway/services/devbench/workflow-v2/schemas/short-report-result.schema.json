{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/short-report-result-v2.json",
  "title": "Short Report Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contextId",
    "contextRevision",
    "idempotencyKey",
    "reportText"
  ],
  "properties": {
    "schemaVersion": {
      "const": "short-report-result-v2"
    },
    "contextId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "contextRevision": {
      "type": "integer",
      "minimum": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "reportText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
