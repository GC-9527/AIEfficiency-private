{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/workflow-checkpoint-v2.json",
  "title": "Workflow Checkpoint v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storyId",
    "revision",
    "claims",
    "actions",
    "changes",
    "verification",
    "openItems",
    "userDecisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "workflow-checkpoint-v2"
    },
    "storyId": {
      "type": "string",
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "maxLength": 1200
    },
    "claims": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "text",
          "status",
          "evidenceIds"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "status": {
            "enum": [
              "VERIFIED",
              "UNVERIFIED",
              "REJECTED",
              "SUPERSEDED"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "VERIFIED"
                }
              }
            },
            "then": {
              "properties": {
                "evidenceIds": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "actionId",
          "status"
        ],
        "properties": {
          "actionId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "COMPLETED",
              "FAILED",
              "BLOCKED"
            ]
          },
          "receiptIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string",
            "maxLength": 800
          }
        },
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "rootId",
          "path",
          "summary"
        ],
        "properties": {
          "rootId": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "summary": {
            "type": "string",
            "maxLength": 1000
          },
          "receiptIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "status"
        ],
        "properties": {
          "caseId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "receiptIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "openItems": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "userDecisions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "decision",
          "at"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "maxLength": 1000
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
