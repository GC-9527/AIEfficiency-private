{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/report-facts-v2.json",
  "title": "Report Facts v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storyIds",
    "confidence",
    "cause",
    "measure",
    "changes",
    "verification",
    "risks",
    "evidenceIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "report-facts-v2"
    },
    "storyIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "cause": {
      "type": "string",
      "maxLength": 1500
    },
    "measure": {
      "type": "string",
      "maxLength": 1500
    },
    "causeUserFriendly": {
      "type": "string",
      "maxLength": 500
    },
    "measureUserFriendly": {
      "type": "string",
      "maxLength": 500
    },
    "changes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "path",
          "summary"
        ],
        "properties": {
          "rootId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "status",
          "receiptIds"
        ],
        "properties": {
          "caseId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "receiptIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "testSuggestions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "evidenceIds": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string"
      }
    },
    "accepted": {
      "type": "boolean"
    }
  }
}
