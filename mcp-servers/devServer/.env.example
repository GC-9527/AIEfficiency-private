# 只在启动 Codex/Node 的宿主进程环境中设置这些变量；不要提交真实凭据。
# 当前测试后台仅提供 HTTP；只可在受信网络使用，后端支持后应改为 HTTPS。
APPMARKET_ADMIN_BASE_URL=http://appgallery-manage.hssstg.com:1080
APPMARKET_ADMIN_ENVIRONMENT=stg

# 三选一：现有 Token；或用户名 + 密码；或由环境变量指向的登录 curl 文件。
APPMARKET_ADMIN_TOKEN=
APPMARKET_ADMIN_USERNAME=
APPMARKET_ADMIN_PASSWORD=
APPMARKET_ADMIN_LOGIN_CURL_FILE=

# 仅当明确切换到其他受控环境时设置，逗号分隔完整 origin。
# APPMARKET_ADMIN_ALLOWED_ORIGINS=http://appgallery-manage.hssstg.com:1080

# 可选运行限制。
APPMARKET_ADMIN_TIMEOUT_MS=20000
APPMARKET_ADMIN_MAX_RESPONSE_BYTES=5242880
APPMARKET_ADMIN_TOKEN_TTL_MS=1500000
