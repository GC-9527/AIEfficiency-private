{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiefficiency.local/schemas/attachment-selection.schema.json",
  "title": "TB Attachment Selection",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "attachmentIds"],
      "properties": {
        "mode": {"const": "selected"},
        "attachmentIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "all"}}
    }
  ]
}
