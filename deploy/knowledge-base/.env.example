# === 对外域名 & HTTPS (Caddy 自动 ACME) ===
DOMAIN=tgcz.appgrabz.com
ACME_EMAIL=admin@appgrabz.com

# === RAG Service ===
COLLECTION_NAME=music_knowledge
OLLAMA_EMBED_MODEL=nomic-embed-text
VECTOR_DIM=768

# === 数据导入 CSV 文件名 (放到 ./importer/data/) ===
CSV_FILE_NAME=merged_songs_deduped_clean_utf8.csv

# === 本机调试端口 (仅绑定 127.0.0.1) ===
RAG_SEARCH_HOST_PORT=3001
QDRANT_HOST_PORT=6333
OLLAMA_HOST_PORT=11434
